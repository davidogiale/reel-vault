<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <ImageView
        android:id="@+id/cover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter" />

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:resize_mode="fit"
        app:shutter_background_color="@android:color/transparent"
        app:surface_type="texture_view"
        app:use_controller="false" />

    <ImageView
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter" />

    <FrameLayout
        android:id="@+id/webHolder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="96dp"
        android:layout_marginBottom="130dp" />

    <View
        android:id="@+id/touchLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ImageView
        android:id="@+id/playIcon"
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_circle_glass"
        android:importantForAccessibility="no"
        android:paddingStart="22dp"
        android:paddingTop="18dp"
        android:paddingEnd="16dp"
        android:paddingBottom="18dp"
        android:src="@drawable/ic_play"
        android:visibility="gone"
        app:tint="@color/fg" />

    <ProgressBar
        android:id="@+id/spinner"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/fg"
        android:visibility="gone" />

    <TextView
        android:id="@+id/error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_pill_strong"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:text="This video couldn't play"
        android:textColor="@color/fg"
        android:visibility="gone" />

    <View
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_shade" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="84dp"
        android:layout_marginBottom="30dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/handle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-black"
            android:maxLines="1"
            android:textColor="@color/fg"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="3"
            android:textColor="@color/fg"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/muted"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="40dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/btnSave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <ImageView android:id="@+id/saveIcon" style="@style/RailCircle" android:contentDescription="Save to phone" android:src="@drawable/ic_bookmark_border" />
            <TextView android:id="@+id/saveLabel" style="@style/RailLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Save" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnSound"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <ImageView android:id="@+id/soundIcon" style="@style/RailCircle" android:contentDescription="Sound" android:src="@drawable/ic_volume_up" />
            <TextView style="@style/RailLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sound" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnSpeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <TextView
                android:id="@+id/speedText"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_circle_glass"
                android:contentDescription="Playback speed"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:text="1×"
                android:textColor="@color/fg"
                android:textSize="15sp" />
            <TextView style="@style/RailLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Speed" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnOpen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <ImageView style="@style/RailCircle" android:contentDescription="Open original" android:src="@drawable/ic_open_in_new" />
            <TextView style="@style/RailLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Open" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnMore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <ImageView style="@style/RailCircle" android:contentDescription="More options" android:src="@drawable/ic_more" />
            <TextView style="@style/RailLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="More" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/timecode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="40dp"
        android:fontFamily="sans-serif-black"
        android:fontFeatureSettings="tnum"
        android:shadowColor="#CC000000"
        android:shadowRadius="10"
        android:textColor="@color/fg"
        android:textSize="22sp"
        android:visibility="gone" />

    <SeekBar
        android:id="@+id/seek"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_gravity="bottom"
        android:background="@null"
        android:maxHeight="3dp"
        android:minHeight="3dp"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:progressDrawable="@drawable/seek_progress"
        android:splitTrack="false"
        android:thumb="@drawable/seek_thumb"
        android:thumbOffset="0dp" />
</FrameLayout>
